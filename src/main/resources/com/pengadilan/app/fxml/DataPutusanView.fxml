<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="804.0" spacing="15.0"
      style="-fx-padding: 20; -fx-background-color: #f4f7f6;"
      stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengadilan.app.controller.DataPutusanController">
    <!-- Header & Toolbar Atas ala SaaS Table -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 12 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 4, 0, 0, 1);">
        <Label text="Manajemen Data Putusan" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
        <Pane HBox.hgrow="ALWAYS" />
        <Button text="Filter" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold;" onAction="#handleBukaFilter"/>
        <Button text="Urutkan" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold;" onAction="#handleUrutkan"/>
        <Button text="Ekspor" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold;" onAction="#handleEkspor"/>
        <Button text="+ Tambah Baru" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;" onAction="#handleTambahData"/>
    </HBox>

    <!-- Bar Pencarian & Info Entri -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="txtCari" promptText="Cari nomor perkara atau case ID..." prefWidth="300.0" />
        <Pane HBox.hgrow="ALWAYS" />
        <Label fx:id="lblInfoEntri" text="Menampilkan 1-50 dari 50 entri" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-weight: bold;" />
    </HBox>

    <!-- Tabel Data Utama dengan Kolom Proporsional -->
    <TableView fx:id="tablePutusan" prefHeight="480.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCaseId" prefWidth="110.0" text="Case ID" />
            <TableColumn fx:id="colNomorPerkara" prefWidth="250.0" text="Nomor Perkara" />
            <TableColumn fx:id="colJenis" prefWidth="180.0" text="Jenis Narkotika" />
            <TableColumn fx:id="colVonis" prefWidth="110.0" text="Vonis (Bulan)" />
            <TableColumn fx:id="colAksi" prefWidth="110.0" text="Aksi" />
        </columns>
    </TableView>

    <!-- Footer Paginasi ala SaaS -->
    <HBox alignment="CENTER" spacing="5.0" style="-fx-padding: 5 0 0 0;">
        <Button text="&lt; Sebelumnya" style="-fx-background-color: white; -fx-text-fill: #334155; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" />
        <Button text="1" style="-fx-background-color: #2563eb; -fx-text-fill: white;" />
        <Button text="2" style="-fx-background-color: white; -fx-text-fill: #334155; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" />
        <Button text="3" style="-fx-background-color: white; -fx-text-fill: #334155; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" />
        <Button text="Selanjutnya &gt;" style="-fx-background-color: white; -fx-text-fill: #334155; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" />
    </HBox>
</VBox>