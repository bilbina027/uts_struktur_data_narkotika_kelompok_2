<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengadilan.app.controller.DataPutusanController"
      spacing="12" styleClass="page">
    <Label text="Data Putusan" styleClass="page-title"/>
    <FlowPane hgap="8" vgap="8">
        <Button text="Tambah" onAction="#handleTambah"/>
        <Button text="Hapus Terpilih" onAction="#handleHapus"/>
        <Button text="Urutkan Vonis" onAction="#handleUrutkan"/>
        <Button text="Tampilkan Semua" onAction="#handleRefresh"/>
        <Button text="Ekspor Tampilan" onAction="#handleEkspor"/>
        <Button text="Ekspor Trace" onAction="#handleEksporTrace"/>
    </FlowPane>
    <HBox spacing="8">
        <TextField fx:id="txtCari"
                   promptText="caseId atau bagian nomor perkara"
                   onAction="#handleCari" HBox.hgrow="ALWAYS"/>
        <Button text="Cari" onAction="#handleCari"/>
    </HBox>
    <TableView fx:id="tablePutusan" VBox.vgrow="ALWAYS"/>
    <Label fx:id="lblStatus" wrapText="true"/>
</VBox>