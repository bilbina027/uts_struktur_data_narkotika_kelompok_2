<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengadilan.app.controller.FilterController"
      spacing="12" styleClass="page">
    <Label text="Filter Gabungan" styleClass="page-title"/>
    <GridPane hgap="12" vgap="10">
        <Label text="Jenis" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbJenisNarkotika" prefWidth="230"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Pasal terbukti"
               GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="txtPasal" promptText="Contoh: 112"
                   GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <Label text="Berat minimum (gram)"
               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtBeratMin"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Berat maksimum (gram)"
               GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="txtBeratMax"
                   GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        <Label text="Vonis minimum (bulan)"
               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtVonisMin"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Vonis maksimum (bulan)"
               GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <TextField fx:id="txtVonisMax"
                   GridPane.rowIndex="2" GridPane.columnIndex="3"/>
    </GridPane>
    <HBox spacing="8">
        <Button text="Terapkan Filter" onAction="#handleFilter"/>
        <Button text="Reset" onAction="#handleReset"/>
        <Button text="Ekspor Hasil CSV" onAction="#handleEkspor"/>
    </HBox>
    <Label text="Batas kosong berarti tanpa pembatasan. Rentang inklusif." wrapText="true"/>
    <TableView fx:id="tableFilter" VBox.vgrow="ALWAYS"/>
    <Label fx:id="lblHasil" wrapText="true"/>
</VBox>
