<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengadilan.app.controller.ImporEksporController"
      spacing="16" styleClass="page">
    <Label text="Impor dan Ekspor" styleClass="page-title"/>
    <Label text="Impor awal wajib memuat tepat 50 putusan nyata. Semua putusan harus berasal dari satu kota yang sama sesuai ketentuan dosen."
           wrapText="true"/>
    <Label text="PDF putusan digunakan sebagai sumber. Aplikasi mengimpor dataset terstruktur CSV agar 16 atribut dapat divalidasi, dicari, difilter, diurutkan, dan diekspor."
           wrapText="true"/>
    <HBox spacing="10">
        <Label text="Kota sumber:"/>
        <TextField fx:id="txtKota" promptText="Contoh: Malang" prefWidth="250"/>
    </HBox>
    <Label text="Jika ada record rusak, duplikat, kota tidak sesuai, atau jumlah bukan 50, data lama tidak diganti."
           wrapText="true"/>
    <HBox spacing="10">
        <Button text="Impor CSV" onAction="#handleImporCSV"/>
        <Button text="Ekspor Semua CSV" onAction="#handleEksporCSV"/>
        <Button text="Ekspor Laporan Teks" onAction="#handleEksporLaporan"/>
    </HBox>
    <Label fx:id="lblStatusImpor" wrapText="true" styleClass="status"/>
</VBox>