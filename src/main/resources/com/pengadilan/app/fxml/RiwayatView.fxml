<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengadilan.app.controller.RiwayatController"
      spacing="12" styleClass="page">
    <Label text="Riwayat Aktivitas" styleClass="page-title"/>
    <Button text="Segarkan Riwayat" onAction="#handleRefresh"/>
    <Label fx:id="lblJumlahLog"/>
    <ListView fx:id="listRiwayat" VBox.vgrow="ALWAYS"/>
    <Label text="Audit menggunakan CustomStack. Pembacaan tidak mengubah urutan. Riwayat tersimpan selama sesi aplikasi."
           wrapText="true"/>
</VBox>