<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pengadilan.app.controller.DashboardController"
      spacing="16" styleClass="page">
    <Label text="Dashboard" styleClass="page-title"/>
    <HBox spacing="16">
        <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="JUMLAH PERKARA"/>
            <Label fx:id="lblTotalPerkara" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="RATA-RATA VONIS"/>
            <Label fx:id="lblRataVonis" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="TOTAL DENDA"/>
            <Label fx:id="lblTotalDenda" styleClass="stat-value"/>
        </VBox>
    </HBox>
    <HBox spacing="10">
        <Button text="Kelola Data" onAction="#handleKelolaData"/>
        <Button text="Filter Lanjutan" onAction="#handleBukaFilter"/>
        <Button text="Impor CSV" onAction="#handleImporBerkas"/>
    </HBox>
    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <PieChart fx:id="chartNarkotika"
                  title="Distribusi label jenis narkotika"
                  HBox.hgrow="ALWAYS" minWidth="0"/>
        <BarChart fx:id="chartVonis" title="Rata-rata vonis"
                  HBox.hgrow="ALWAYS" minWidth="0">
            <xAxis><CategoryAxis/></xAxis>
            <yAxis><NumberAxis label="Bulan" forceZeroInRange="true"/></yAxis>
        </BarChart>
    </HBox>
</VBox>
